# Copy this file to .env.local and fill in real values from your Stripe dashboard.
# .env.local is gitignored — never commit real keys.
#
# Use TEST MODE values while developing (toggle "Test mode" in the Stripe
# dashboard first) — sk_test_... and price IDs created while in test mode.
# Only switch to live values once a full test purchase has worked end to end.

# Stripe secret key (test mode: sk_test_..., live mode: sk_live_...)
STRIPE_SECRET_KEY=

# Price IDs for the two plans (both subscriptions) — must start with "price_", not "prod_".
# Find them on each Product's page in the Stripe dashboard, under "Pricing".
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# Signing secret for the FOV Pro webhook endpoint (from `stripe listen` in dev,
# or the webhook's settings page in the dashboard for production).
# Server-side only. Never prefix with NEXT_PUBLIC_.
STRIPE_WEBHOOK_SECRET=

# Supabase service-role key. The Stripe webhook uses it to write entitlements.
# Bypasses row-level security, so server-side only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build Stripe's success/cancel redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — used for the beta "register interest" list and for emailing you
# contact-form submissions. Get the API key from resend.com/api-keys.
# Every Resend account has one default Audience; contacts are added to it
# directly, no audience ID needed.
RESEND_API_KEY=

# Where "Talk to us" contact form submissions get emailed to.
CONTACT_NOTIFY_EMAIL=

# Supabase — user accounts (sign up / log in / account page, and the login
# gate on /cctv). From Supabase dashboard → Project Settings → API Keys.
# Leave blank to run in "guest mode": the CCTV tool stays open to everyone and
# the login pages say accounts are being switched on. NEXT_PUBLIC_ values are
# baked in at build time, so redeploy after setting them in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile (free CAPTCHA) for the public forms, sign-up, login and
# password reset. Create a widget at dash.cloudflare.com -> Turnstile, add
# plotlvcad.co.uk, then set BOTH keys in Vercel and redeploy. Only after that
# is live, turn on Supabase -> Authentication -> Attack Protection -> CAPTCHA
# with the same secret key. Leave blank to run without CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- FOV Pro (2026-11 redesign) -------------------------------------------
# Switch: checkout only works when this is exactly 1.
PRO_CHECKOUT_ENABLED=
# Price IDs (price_…) for the two Pro prices, in the same mode as STRIPE_SECRET_KEY.
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
# Signing secret (whsec_…) of the webhook endpoint <site>/api/stripe/webhook
STRIPE_PRO_WEBHOOK_SECRET=
# Supabase secret key (sb_secret_…), server only: lets the webhook switch Pro on/off.
SUPABASE_SECRET_KEY=
# Optional: 1 to charge UK VAT with Stripe Tax (set Tax up in Stripe first).
STRIPE_AUTOMATIC_TAX=
# Public launch switch for FOV Pro. Leave empty to show Pro as "coming soon"
# with a notify-me form; set to 1 (and redeploy) to show prices with Buy buttons.
NEXT_PUBLIC_PRO_LIVE=
