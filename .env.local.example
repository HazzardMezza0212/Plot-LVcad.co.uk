# Copy this file to .env.local and fill in real values from your Stripe dashboard.
# .env.local is gitignored — never commit real keys.
#
# Use TEST MODE values while developing (toggle "Test mode" in the Stripe
# dashboard first) — sk_test_... and price IDs created while in test mode.
# Only switch to live values once a full test purchase has worked end to end.

# Stripe secret key (test mode: sk_test_..., live mode: sk_live_...)
STRIPE_SECRET_KEY=

# Price IDs for the two plans — must start with "price_", not "prod_".
# Find them on each Product's page in the Stripe dashboard, under "Pricing".
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_LIFETIME=

# Signing secret for the Stripe webhook endpoint (from `stripe listen` in dev,
# or the webhook's settings page in the dashboard for production).
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe's success/cancel redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — used for the beta "register interest" list and for emailing you
# contact-form submissions. Get the API key from resend.com/api-keys.
# Every Resend account has one default Audience; contacts are added to it
# directly, no audience ID needed.
RESEND_API_KEY=

# Where "Talk to us" contact form submissions get emailed to.
CONTACT_NOTIFY_EMAIL=

# Supabase — user accounts (sign up / log in / account page, and the login
# gate on /cctv). From Supabase dashboard → Project Settings → API Keys.
# Leave blank to run in "guest mode": the CCTV tool stays open to everyone and
# the login pages say accounts are being switched on. NEXT_PUBLIC_ values are
# baked in at build time, so redeploy after setting them in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- FOV Founding 20 (see lib/founding.js) ----
# Switch: leave blank until you're ready to sell. "1" opens checkout.
FOUNDING_CHECKOUT_ENABLED=
# Price ID of the £99/year price (price_…), same mode (test/live) as STRIPE_SECRET_KEY.
STRIPE_PRICE_ID_FOUNDING=
# Signing secret of the /api/stripe/webhook endpoint (whsec_…).
STRIPE_FOUNDING_WEBHOOK_SECRET=
# "1" = charge UK VAT with Stripe Tax (Stripe → Settings → Tax must be set up).
STRIPE_AUTOMATIC_TAX=
# Supabase secret key (sb_secret_…). Server only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
